FROM python:3.9-slim

# Install system dependencies for ML libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    libssl-dev \
    libffi-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /home/btap_ml

# Copy only surrogate model dependencies
COPY requirements-surrogate.txt ./requirements.txt

# Install numpy first to ensure binary compatibility
RUN pip install --no-cache-dir numpy==1.23.5

RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and models
COPY src ./src
COPY input ./input

# Create output directory
RUN mkdir -p output

# Start surrogate API only (run from /home/btap_ml so relative imports work)
CMD ["gunicorn", \
     "--bind", "0.0.0.0:8000", \
     "--workers", "2", \
     "--worker-class", "uvicorn.workers.UvicornWorker", \
     "--timeout", "300", \
     "src.api.main_surrogate:app"]
